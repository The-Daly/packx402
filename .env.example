# PackX402 environment configuration
# Copy to .env.local for local dev. NEVER commit a file containing real values.
# Every secret below must be provisioned per-environment (local/staging/prod) — do not share across environments.

# ---------------------------------------------------------------------------
# Core app
# ---------------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
APP_ENV=development                     # development | staging | production
LOG_LEVEL=info

# 32+ byte random secret used to sign/verify session tokens and CSRF tokens.
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# 32-byte hex key used to encrypt sensitive DB fields (shipping addresses, etc.)
# Generate with: openssl rand -hex 32
FIELD_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Database (Postgres via Drizzle ORM)
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://packx402:packx402@localhost:5432/packx402

# ---------------------------------------------------------------------------
# Redis-compatible cache / rate limiting / queues
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Email (transactional: verification, recovery, notifications)
# Provider-agnostic SMTP. Leave unset in dev to use the console/log adapter.
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=console                  # console | smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=PackX402 <no-reply@packx402.example>

# ---------------------------------------------------------------------------
# S3-compatible object storage (profile images, showcase covers)
# ---------------------------------------------------------------------------
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=packx402-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# Algorand / x402 payments
# x402 defaults to TestNet. MainNet requires ALGORAND_NETWORK=mainnet to be
# set explicitly AND ALGORAND_MAINNET_ENABLED=true. Never automate this.
# ---------------------------------------------------------------------------
ALGORAND_NETWORK=testnet                # testnet | mainnet
ALGORAND_MAINNET_ENABLED=false
ALGORAND_ALGOD_URL=https://testnet-api.algonode.cloud
ALGORAND_ALGOD_TOKEN=
ALGORAND_USDC_ASSET_ID=10458941         # TestNet USDC ASA id
MERCHANT_ALGORAND_ADDRESS=

# GoPlausible x402 facilitator. When unset, the app runs in X402_FACILITATOR_MODE=mock
# (a deterministic in-process facilitator for local dev/CI — never use in production).
X402_FACILITATOR_MODE=mock              # mock | live
X402_FACILITATOR_URL=
X402_FACILITATOR_API_KEY=
X402_BAZAAR_DISCOVERY_ENABLED=true

# ---------------------------------------------------------------------------
# Solana payments (TestNet-only during beta)
# ---------------------------------------------------------------------------
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
MERCHANT_SOLANA_ADDRESS=

# ---------------------------------------------------------------------------
# EVM payments (TestNet-only during beta; e.g. Base Sepolia)
# ---------------------------------------------------------------------------
EVM_NETWORK=base-sepolia
EVM_RPC_URL=https://sepolia.base.org
EVM_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7
MERCHANT_EVM_ADDRESS=

# ---------------------------------------------------------------------------
# Supplier: CardTrader
# When CARDTRADER_API_TOKEN is unset, SupplierAdapter runs in
# CARDTRADER_MODE=mock (deterministic fixture inventory, no live purchases).
# ---------------------------------------------------------------------------
CARDTRADER_MODE=mock                    # mock | live
CARDTRADER_API_BASE_URL=https://api.cardtrader.com/api/v2
CARDTRADER_API_TOKEN=
CARDTRADER_ACCOUNT_ID=

# ---------------------------------------------------------------------------
# Feature flags / safety switches
# ---------------------------------------------------------------------------
FEATURE_HIGH_VALUE_PACKS_ENABLED=false  # server-side gate for packs > $250 (bankroll-limited during beta)
FEATURE_LOYALTY_ENABLED=true
FEATURE_LOYALTY_KILL_SWITCH=false
FEATURE_AFFILIATE_PROGRAM_ENABLED=true
FEATURE_SOCIAL_ENABLED=true

# ---------------------------------------------------------------------------
# Admin
# ---------------------------------------------------------------------------
ADMIN_REAUTH_TTL_SECONDS=900

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
SENTRY_DSN=
